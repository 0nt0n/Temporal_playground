TEMPORAL_ADDRESS=localhost:7233
CLOUD_RU_API_KEY=

# MinIO (локально — дефолты docker-compose, на Railway — из сервиса MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts
MINIO_SECURE=false

# Параметры workflow/activity (опциональные, значения по умолчанию в app/config.py)
TASK_QUEUE=my-task-queue
ACTIVITY_TIMEOUT_MINUTES=5
HEARTBEAT_TIMEOUT_SECONDS=5
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_INTERVAL_SECONDS=1
